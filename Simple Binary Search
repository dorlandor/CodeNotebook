def binary_search(numbers, target):
   low = 0
   high = len(numbers) - 1


   while low <= high:
       mid = (low + high) // 2
       if numbers[mid] == target:
           return mid
       elif numbers[mid] < target:
           low = mid + 1
       else:
           high = mid - 1


   return -1




numbers = [3, 8, 12, 20, 27, 35, 40]


print(binary_search(numbers, 3))
print(binary_search(numbers, 14))
